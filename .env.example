# =============================================================================
# AI-Based Smart Plant Disease Detection - environment configuration
#
# Copy this file to `.env` in the project root and edit as needed:
#
#     Windows : copy .env.example .env
#     Linux   : cp .env.example .env
#
# Every value below has a working default in backend/config.py, so the system
# runs with no .env at all. Set a variable only when you need to change it.
# Never commit your real .env - it is listed in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# Flask server
# -----------------------------------------------------------------------------
# 0.0.0.0 binds every network interface, which is required for the ESP32-CAM
# to reach the API. Use 127.0.0.1 to restrict access to this machine only.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Enables the interactive debugger and verbose tracebacks. Keep this false
# unless you are actively debugging - debug mode exposes a remote code
# execution console to anyone who can reach the port.
FLASK_DEBUG=false

# development | production | testing
# `production` additionally defaults ALLOW_TEST_MODE_MODEL to false.
APP_ENV=development

# Used to sign Flask session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# A random key is generated at startup if this is unset, which logs everyone
# out on each restart - fine for development, set it for anything persistent.
SECRET_KEY=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Image uploads
# -----------------------------------------------------------------------------
# Where captured and uploaded images are stored. Relative paths resolve
# against the project root.
UPLOAD_FOLDER=backend/uploads

# Rejected above this size with a 413 response. An SVGA JPEG from the
# ESP32-CAM is typically 40-90 KB, so 12 MB is generous headroom for uploads
# from a phone camera.
MAX_UPLOAD_MB=12

# Set to false to classify images without keeping them on disk. The history
# page then has no thumbnails, so leave it true unless storage is constrained.
KEEP_UPLOADED_IMAGES=true


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite file. The schema is applied automatically on first start.
DATABASE_PATH=backend/database/plant_disease.db


# -----------------------------------------------------------------------------
# Machine learning model
# -----------------------------------------------------------------------------
MODEL_PATH=ml/saved_model/plant_disease_model.keras
LABELS_PATH=ml/class_labels.json
MODEL_METADATA_PATH=ml/saved_model/metadata.json
REPORTS_DIR=ml/reports

# Minimum top-1 softmax probability before a disease is named. Below this the
# API returns an explicit "uncertain" result instead of a diagnosis.
# Raise it to reduce false diagnoses; lower it to get fewer abstentions.
# train.py prints a suggested value based on the evaluated model.
CONFIDENCE_THRESHOLD=0.70

# Reject blurred, dark, over-exposed or leaf-free frames before inference and
# return "unknown". Disabling this makes the model guess on unusable images.
ENFORCE_QUALITY_GATE=true

# Load the model during startup rather than on the first request. Startup
# takes a few seconds longer; the first prediction is much faster.
EAGER_MODEL_LOAD=true

# Allow predictions from the untrained bootstrap model created by
# ml/create_test_model.py. Such responses are always flagged with
# is_validated_prediction=false and the dashboard shows a test-mode banner.
# Set to false to refuse them entirely (recommended once trained).
ALLOW_TEST_MODE_MODEL=true

# --- Image quality thresholds (see ml/preprocessing.py) ----------------------
# Variance of the Laplacian; lower means blurrier. Raise if blurred frames
# are getting through, lower if sharp frames are being rejected.
QUALITY_MIN_SHARPNESS=30
# Mean luminance, 0-255.
QUALITY_MIN_BRIGHTNESS=25
QUALITY_MAX_BRIGHTNESS=240
# Standard deviation of luminance; catches near-blank frames.
QUALITY_MIN_CONTRAST=12
# Minimum fraction of leaf-like (green/brown) pixels; catches photos of walls,
# hands and sky.
QUALITY_MIN_PLANT_RATIO=0.04
# Shortest image side, in pixels.
QUALITY_MIN_SIDE_PIXELS=64


# -----------------------------------------------------------------------------
# Universal plant analysis
# -----------------------------------------------------------------------------
# The species-agnostic computer-vision layer. This is what lets ANY plant be
# analysed instead of forcing every image into the classifier's 10 trained
# classes. It measures leaf colour, lesion blobs, margin necrosis, powdery
# coating, holes and mottling, then maps those measurements to a shortlist of
# possible conditions with the evidence for each.
#
# Needs no API key and no extra model - it is classical OpenCV. Leave enabled.
UNIVERSAL_ANALYSIS_ENABLED=true


# -----------------------------------------------------------------------------
# AI vision API (optional)
# -----------------------------------------------------------------------------
# Supplies the one thing local code genuinely cannot do: identify the plant
# species from the image. Without it the system still works - the species comes
# from the dropdown the user picks, and symptoms come from local measurement.
#
# When disabled, /api/health and the dashboard both say so explicitly. Nothing
# is invented to fill the gap.
VISION_API_ENABLED=false

# openai | gemini | anthropic | openai_compatible
# Use openai_compatible for a self-hosted or proxy endpoint that speaks the
# OpenAI chat-completions schema (LM Studio, vLLM, OpenRouter, LiteLLM, ...).
VISION_API_PROVIDER=openai

# Your API key. Keep it out of version control - .env is gitignored.
VISION_API_KEY=

# Model name. It must support image input:
#   openai     gpt-4o-mini, gpt-4o
#   gemini     gemini-1.5-flash, gemini-1.5-pro
#   anthropic  claude-3-5-sonnet-latest, claude-3-5-haiku-latest
VISION_API_MODEL=gpt-4o-mini

# Override only for a self-hosted or proxied endpoint, e.g.
#   http://localhost:1234/v1
VISION_API_BASE_URL=

# Seconds to wait for the vision response before giving up and continuing with
# local measurements alone.
VISION_API_TIMEOUT=45


# -----------------------------------------------------------------------------
# ESP32-CAM
# -----------------------------------------------------------------------------
# Static IP of the camera, as printed in its serial monitor. Leave EMPTY to
# let the board register itself: the firmware POSTs /api/device/register with
# its current address, so this keeps working across DHCP lease changes.
ESP32_CAM_IP=
ESP32_CAM_PORT=80

# Must match DEVICE_NAME in esp32cam/plant_disease_camera.ino.
ESP32_CAM_NAME=esp32-cam-01

# Firmware endpoints - change only if you modified the sketch.
ESP32_CAPTURE_PATH=/capture
ESP32_STATUS_PATH=/status
ESP32_LED_PATH=/led

# Seconds to wait for a frame when pulling directly from the camera. A large
# frame size over a weak signal needs the higher end of this.
ESP32_REQUEST_TIMEOUT=20
ESP32_STATUS_TIMEOUT=4

# The dashboard shows the camera as offline after this many seconds without a
# heartbeat. Must be comfortably larger than HEARTBEAT_INTERVAL_MS in the
# sketch (10s by default).
ESP32_OFFLINE_AFTER_SECONDS=45

# When the backend cannot open a connection to the camera (client-isolated
# Wi-Fi, different subnet, unknown IP), queue a capture command for the board
# to collect on its next poll and wait this long for the image.
ENABLE_PUSH_CAPTURE_FALLBACK=true
CAPTURE_JOB_TIMEOUT=30

# Shared secret for the firmware endpoints (/api/device/register, /command,
# /upload). Leave empty to disable the check. If set, the same value must go
# into DEVICE_API_KEY in the sketch.
DEVICE_API_KEY=


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Browser origins allowed to call the API. The Vite dev server is 5173 and
# `npm run preview` is 4173. Add your machine's LAN address to open the
# dashboard from a phone, e.g. http://192.168.1.50:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Allow every origin. Convenient for a lab demo where addresses are not known
# in advance; do not leave it enabled on a network you do not control.
CORS_ALLOW_ALL=false


# -----------------------------------------------------------------------------
# API behaviour
# -----------------------------------------------------------------------------
HISTORY_PAGE_SIZE=20
HISTORY_MAX_PAGE_SIZE=200


# -----------------------------------------------------------------------------
# Frontend (read by Vite at build time, not by Flask)
# -----------------------------------------------------------------------------
# These belong in frontend/.env - see frontend/.env.example.
#
# VITE_BACKEND_URL   Proxy target used by `npm run dev` (default
#                    http://127.0.0.1:5000). Point it at another machine to
#                    develop the UI against a backend running elsewhere.
# VITE_API_BASE_URL  Absolute API URL baked into a production build. Leave
#                    empty when the dashboard and API share an origin.
