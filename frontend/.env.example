# =============================================================================
# Frontend environment (Vite)
#
# Copy to `frontend/.env` if you need to change either value:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux / macOS)
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put a secret in this file - everything here ships to the client.
# =============================================================================

# Proxy target for `npm run dev` and `npm run preview`.
# The dev server forwards /api and /uploads here, which keeps all frontend
# requests same-origin and avoids CORS entirely during development.
# Point this at another machine to develop the UI against a remote backend.
VITE_BACKEND_URL=http://127.0.0.1:5000

# Absolute API base URL compiled into a production build (`npm run build`).
# Leave EMPTY when the built dashboard is served from the same origin as the
# API (the usual case). Set it only when the two are on different hosts, e.g.
#   VITE_API_BASE_URL=http://192.168.1.100:5000
# Remember to add that origin to CORS_ORIGINS in the backend .env as well.
VITE_API_BASE_URL=
